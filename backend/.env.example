# Database (Required)
DATABASE_URL=postgresql://user:password@localhost:5432/birthday_app

# Firebase Admin SDK (Optional - set ENABLE_FIREBASE=true to use)
# Leave ENABLE_FIREBASE commented out or set to false for testing without auth
# ENABLE_FIREBASE=true
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Environment
NODE_ENV=development
PORT=3000

# CORS (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:3000,https://your-app.com
